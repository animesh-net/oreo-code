{
  "name": "oreo-code",
  "displayName": "Oreo Code",
  "description": "Chat and coding agent for oreo-ai, inside VS Code.",
  "version": "0.1.0",
  "publisher": "animesh-net",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/animesh-net/oreo-code.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "oreo",
          "title": "Oreo",
          "icon": "media/oreo.svg"
        }
      ]
    },
    "views": {
      "oreo": [
        {
          "type": "webview",
          "id": "oreo.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "oreo.signIn",
        "title": "Sign in",
        "category": "Oreo"
      },
      {
        "command": "oreo.signOut",
        "title": "Sign out",
        "category": "Oreo"
      },
      {
        "command": "oreo.newChat",
        "title": "New chat",
        "category": "Oreo",
        "icon": "$(add)"
      },
      {
        "command": "oreo.setGithubToken",
        "title": "Set GitHub token",
        "category": "Oreo"
      },
      {
        "command": "oreo.clearGithubToken",
        "title": "Clear GitHub token",
        "category": "Oreo"
      },
      {
        "command": "oreo.showGithubTools",
        "title": "Show GitHub tools",
        "category": "Oreo"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "oreo.newChat",
          "when": "view == oreo.chat",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Oreo",
      "properties": {
        "oreo.serverUrl": {
          "type": "string",
          "default": "https://ai.animesh.org.in",
          "description": "Base URL of your oreo-ai server. Reached over Tailscale."
        },
        "oreo.githubMcp.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to your own `github-mcp-server` binary. Leave empty to download the pinned release into the extension's storage, checked against its SHA-256."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview-ui",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "openai": "^7.55.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,mts,json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  }
}
