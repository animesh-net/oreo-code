{
  "name": "oreo-code",
  "displayName": "Oreo Code",
  "description": "Chat and coding agent on your Mac's Ollama, inside VS Code.",
  "version": "0.2.0",
  "publisher": "animesh-net",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/animesh-net/oreo-code.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "oreo",
          "title": "Oreo Code",
          "icon": "media/oreo.svg"
        }
      ]
    },
    "views": {
      "oreo": [
        {
          "type": "webview",
          "id": "oreo.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "oreo.newChat",
        "title": "New chat",
        "category": "Oreo Code",
        "icon": "$(add)"
      },
      {
        "command": "oreo.setGithubToken",
        "title": "Set GitHub token",
        "category": "Oreo Code"
      },
      {
        "command": "oreo.clearGithubToken",
        "title": "Clear GitHub token",
        "category": "Oreo Code"
      },
      {
        "command": "oreo.showGithubTools",
        "title": "Show GitHub tools",
        "category": "Oreo Code"
      },
      {
        "command": "oreo.checkForUpdates",
        "title": "Check for updates",
        "category": "Oreo Code"
      },
      {
        "command": "oreo.toggleCompletion",
        "title": "Turn completion on or off",
        "category": "Oreo Code"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "oreo.newChat",
          "when": "view == oreo.chat",
          "group": "navigation"
        },
        {
          "command": "oreo.checkForUpdates",
          "when": "view == oreo.chat",
          "group": "9_update"
        }
      ]
    },
    "configuration": {
      "title": "Oreo Code",
      "properties": {
        "oreo.ollamaUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "markdownDescription": "Base URL of Ollama, which serves the Oreo models. On a local address (the default), the Mac's Tailscale address is tried too when nothing answers, as oreo-ai's script makes Ollama listen there."
        },
        "oreo.githubMcp.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to your own `github-mcp-server` binary. Leave empty to download the pinned release into the extension's storage, checked against its SHA-256."
        },
        "oreo.autoUpdate": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Install new Oreo Code releases from GitHub on its own (at start-up and every 6 hours), then offer a reload. Uses the GitHub token from `Oreo Code: Set GitHub token`, which needs Contents (read) on `animesh-net/oreo-code`."
        },
        "oreo.cloudUrl": {
          "type": "string",
          "default": "https://ai.animesh.org.in/v1",
          "markdownDescription": "oreo-ai's Workers AI relay on the Pi, reachable over Tailscale only, for the Cloudflare models (Oreo 30B, Oreo 120B). oreo-ai holds the Cloudflare token; what you send these models leaves the Mac. Leave empty to turn the Cloudflare models off."
        },
        "oreo.completion.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Inline code completion (ghost text) from Oreo 1.5B on the Mac's Ollama, with snippets from this repository. Nothing is sent to oreo-ai or Cloudflare."
        },
        "oreo.completion.disabledLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "plaintext",
            "markdown"
          ],
          "markdownDescription": "Language ids (such as `markdown`) where inline completion is off."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview-ui",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.mts",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "markdown-it": "^14.3.3",
    "openai": "^7.55.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,mts,json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.8"
    }
  }
}
